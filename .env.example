# Copy this file to .env and fill in your actual keys.
# .env is gitignored — never commit real keys.
# Run `python scripts/check_env.py` to validate your environment.

# Required for Anthropic Claude models (haiku, sonnet, opus)
ANTHROPIC_API_KEY=sk-ant-...

# Required for OpenAI models (gpt-4o, gpt-4o-mini, o3, etc.)
# Leave blank if not using OpenAI provider
OPENAI_API_KEY=sk-...

# Required for Google Gemini models
# Leave blank if not using Google provider
GOOGLE_API_KEY=AIza...
